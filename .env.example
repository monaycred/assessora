# ================================================
# IASMIN - Assessora Virtual
# Copie este arquivo para .env.local e preencha
# ================================================

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# OPENAI
OPENAI_API_KEY=sk-...

# EVOLUTION API (WhatsApp)
# URL do painel da Evolution (ex: https://evolution-evolution-api.k4ezzu.easypanel.host)
EVOLUTION_API_URL=https://evolution-evolution-api.k4ezzu.easypanel.host
EVOLUTION_API_KEY=sua_api_key_aqui
# Nome exato da instância criada na Evolution API
EVOLUTION_INSTANCE_NAME=TMT2

# WEBHOOK
WEBHOOK_SECRET=um_segredo_aleatorio_forte_aqui

# APP
NEXT_PUBLIC_APP_URL=https://assessora.gedaias.com
NEXT_PUBLIC_APP_NAME=Iasmin

# ADMIN (CPF do admin principal)
ADMIN_CPF=00000000000

# GOOGLE (OAuth - configurar no Google Console)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
